# Supabase — copy this file to .env.local and fill in real values.
# Project: knvykpqhrgbogicfoncs

# Public (safe to expose to the browser). Find at:
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://knvykpqhrgbogicfoncs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — SERVER ONLY. Bypasses Row Level Security. Never expose to the
# browser, never commit. Only needed if you use admin-level server code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI (server-only — NEVER expose to the browser, NEVER commit) ───
# Google Gemini (Generative Language API). Get a free key at
# https://aistudio.google.com/apikey . Note: gemini-2.0-flash is retired;
# gemini-3.5-flash is a current stable free flash model.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
